# ==============================================================================

# Instalar y cargar gridExtra si no está disponible
if (!requireNamespace("gridExtra", quietly = TRUE)) {
  install.packages("gridExtra")
}
if (!requireNamespace("grid", quietly = TRUE)) {
  install.packages("grid")
}
library(grid)
library(gridExtra)

# 1. Crear la tabla cruzada con sumas marginales
tabla_cruzada <- table(datos$Provincia, datos$Cultivo)
tabla_totales <- addmargins(tabla_cruzada)

# 2. Seleccionar una sección representativa para que sea 100% legible en el visor
# (Primeras 7 provincias y 6 cultivos más frecuentes + columna y fila de Totales)
n_filas <- 7
n_cols  <- 6

sub_tabla <- tabla_totales[c(1:n_filas, nrow(tabla_totales)), 
                           c(1:n_cols, ncol(tabla_totales))]

df_plot <- as.data.frame.matrix(sub_tabla)
# Agregar el nombre de la provincia como primera columna visible
df_plot <- cbind(Provincia = rownames(df_plot), df_plot)
rownames(df_plot) <- NULL

# Renombrar la última fila de suma
df_plot$Provincia[nrow(df_plot)] <- "Total (n)"

# 3. Estilo visual de la tabla (paleta azul acorde al taller)
tema_tabla <- ttheme_default(
  core = list(
    bg_params = list(fill = c("#F2F4F8", "#FFFFFF")),
    fg_params = list(fontsize = 9)
  ),
  colhead = list(
    bg_params = list(fill = "#2E5B82"),
    fg_params = list(col = "white", fontface = "bold", fontsize = 9)
  ),
  rowhead = list(
    fg_params = list(fontface = "bold", fontsize = 9)
  )
)

# 4. Enviar la tabla directamente al panel de Plots
grid.newpage()
titulo <- textGrob("Tabulación Cruzada: Frecuencias Conjuntas y Totales", 
                   gp = gpar(fontsize = 12, fontface = "bold", col = "#1F385C"), 
                   y = 0.92)

tabla_grafica <- tableGrob(df_plot, rows = NULL, theme = tema_tabla)

grid.arrange(titulo, tabla_grafica, heights = c(0.12, 0.88))
